@model QuizApp.Models.Quiz

@{
    ViewData["Title"] = "Edit Quiz";
}

<h1>Edit Quiz</h1>

<form asp-action="Edit" method="post" id="quizForm">
    <input type="hidden" asp-for="QuizId" />

    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Quiz Information</h5>
        </div>
        <div class="card-body">
            <div class="form-group mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">Questions</h5>
        </div>
        <div class="card-body">
            <div id="questionsContainer">
                @* Render existing questions *@
                @if (Model.Questions != null && Model.Questions.Any())
                {
                    @for (int qIndex = 0; qIndex < Model.Questions.Count; qIndex++)
                    {
                        var question = Model.Questions[qIndex];
                        <div class="card mb-3 question-card" id="question-@qIndex">
                            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                <h6 class="mb-0">Question @(qIndex + 1)</h6>
                                <button type="button" class="btn btn-danger btn-sm" onclick="removeQuestion(@qIndex)">
                                    Remove
                                </button>
                            </div>
                            <div class="card-body">
                                <input type="hidden" name="Questions[@qIndex].QuestionId" value="@question.QuestionId" />
                                
                                <div class="form-group mb-3">
                                    <label class="form-label">Question Text</label>
                                    <input type="text" name="Questions[@qIndex].QuestionText" 
                                           value="@question.QuestionText" class="form-control" required />
                                </div>
                                
                                <div class="mb-2">
                                    <strong>Answer Options:</strong>
                                </div>
                                
                                <div id="optionsContainer-@qIndex" class="ms-3">
                                    @* Render existing options *@
                                    @if (question.Options != null && question.Options.Any())
                                    {
                                        @for (int oIndex = 0; oIndex < question.Options.Count; oIndex++)
                                        {
                                            var option = question.Options[oIndex];
                                            <div class="row mb-2 align-items-center option-row" id="question-@qIndex-option-@oIndex">
                                                <input type="hidden" name="Questions[@qIndex].Options[@oIndex].OptionsId" value="@option.OptionsId" />
                                                
                                                <div class="col-md-1">
                                                    <div class="form-check">
                                                        <input type="checkbox" name="Questions[@qIndex].Options[@oIndex].IsCorrect" 
                                                               value="true" class="form-check-input" id="q@(qIndex)opt@(oIndex)"
                                                               @(option.IsCorrect ? "checked" : "")
                                                               onchange="clearValidationError(@qIndex)">
                                                        <input type="hidden" name="Questions[@qIndex].Options[@oIndex].IsCorrect" value="false">
                                                        <label class="form-check-label small" for="q@(qIndex)opt@(oIndex)">Correct</label>
                                                    </div>
                                                </div>
                                                <div class="col-md-9">
                                                    <input type="text" name="Questions[@qIndex].Options[@oIndex].Text" 
                                                           value="@option.Text" class="form-control form-control-sm" 
                                                           placeholder="Enter option text" required />
                                                </div>
                                                <div class="col-md-2">
                                                    <button type="button" class="btn btn-sm btn-danger" onclick="removeOption(@qIndex, @oIndex)">
                                                        Remove
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                                
                                <button type="button" class="btn btn-sm btn-outline-primary mt-2" onclick="addOption(@qIndex)">
                                    Add Option
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>
            <button type="button" class="btn btn-success btn-sm mt-3" onclick="addQuestion()">
                Add Question
            </button>
        </div>
    </div>

    <div class="mb-3">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/quiz-form.js"></script>
    
    <script>
        // Initialize for edit (load existing quiz data)
        initializeQuestionIndex(@(Model.Questions?.Count ?? 0));
        
        // Initialize option indexes for existing questions
        var indexes = {};
        @if (Model.Questions != null && Model.Questions.Any())
        {
            @for (int qIndex = 0; qIndex < Model.Questions.Count; qIndex++)
            {
                <text>indexes[@qIndex] = @(Model.Questions[qIndex].Options?.Count ?? 0);</text>
            }
        }
        initializeOptionIndexes(indexes);
    </script>
}


