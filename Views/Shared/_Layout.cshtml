<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuizApp</title>

@* Bootstrap CSS *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css
" rel="stylesheet" />

    @* Custom site CSS *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">

    @* Navbar *@
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Quiz" asp-action="Index">QuizApp</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Quiz" asp-action="Index">All Quizzes</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Quiz" asp-action="Create">Create Quiz</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="QuizPlay" asp-action="Start" asp-route-id="1">Take Sample Quiz</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    @* Main content area *@
    <main class="container mt-4 mb-5">
        @RenderBody()
    </main>

    @* Footer *@
    <footer class="bg-dark text-light text-center py-3 mt-auto">
        <div class="container">
            <small>&copy; @DateTime.Now.Year - QuizApp MVP</small>
        </div>
    </footer>

    @* Scripts *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js
"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>

