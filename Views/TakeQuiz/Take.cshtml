@model QuizApp.Models.Quiz

@{
    ViewData["Title"] = "Take Quiz - " + Model.Title;
}

<div class="container mt-4">
    <h1>@Model.Title</h1>
    <p class="lead">@Model.Description</p>
    <hr />

    <form asp-action="Submit" method="post">
        <input type="hidden" name="quizId" value="@Model.QuizId" />

        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            var question = Model.Questions[i];
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Question @(i + 1)</h5>
                </div>
                <div class="card-body">
                    <p class="card-text">@question.QuestionText</p>
                    
                    <div class="ms-3">
                        @foreach (var option in question.Options)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input" 
                                       type="checkbox" 
                                       name="selectedAnswers" 
                                       value="@option.OptionsId" 
                                       id="option-@option.OptionsId">
                                <label class="form-check-label" for="option-@option.OptionsId">
                                    @option.Text
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="d-flex justify-content-between mt-4">
            <a asp-controller="Quiz" asp-action="Index" class="btn btn-secondary">Back to Quizzes</a>
            <button type="submit" class="btn btn-primary btn-lg">Submit Quiz</button>
        </div>
    </form>
</div>
